{
  "name": "@bureau/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node --import tsx src/main.ts",
    "worker": "node --import tsx src/worker-main.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sql": "node --import tsx tests/sql.integration.ts",
    "test:legacy-http": "node --import tsx tests/legacy.http.ts"
  },
  "dependencies": {
    "@bureau/contracts": "0.2.0",
    "fastify": "5.12.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "mssql": "^12.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0",
    "@types/mssql": "^9.1.0"
  }
}
